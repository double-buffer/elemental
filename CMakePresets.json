{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Config",
            "description": "Build for the current platform using Ninja",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "binaryDir": "${sourceDir}/build"
        },
        {
            "name": "test",
            "inherits": "default",
            "displayName": "Test Config",
            "binaryDir": "${sourceDir}/build-test"
        },
        {
            "name": "release",
            "inherits": "default",
            "displayName": "Release",
            "description": "Release build",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ios",
            "inherits": "default",
            "displayName": "iOS Build",
            "description": "Build iOS with Xcode",
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build-ios",
            "cacheVariables": {
                "BUILD_FOR_IOS": "ON",
                "CMAKE_BUILD_TYPE": null
            }
        },
        {
            "name": "xcode",
            "inherits": "default",
            "displayName": "macOS Xcode Build",
            "description": "Build macOS with Xcode",
            "generator": "Xcode",
            "binaryDir": "${sourceDir}/build-xcode"
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "test",
            "configurePreset": "test"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "ios",
            "configurePreset": "ios"
        }
    ]
}
